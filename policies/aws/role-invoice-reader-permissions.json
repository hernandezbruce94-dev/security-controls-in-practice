{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ListIncomingOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::meridian-invoices-prod",
      "Condition": { "StringLike": { "s3:prefix": "incoming/*" } } },
    { "Sid": "ReadIncoming",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::meridian-invoices-prod/incoming/*" },
    { "Sid": "DecryptWithInvoiceKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:<account-id>:key/<key-id>" }
  ]
}
